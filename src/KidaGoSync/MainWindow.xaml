<Window x:Class="KidaGoSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidaGo Sync" Width="640" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <!-- Fixed single-window size, no responsive variants (FEAT-005 UI Definition). -->
    <Grid Margin="32">
        <StackPanel HorizontalAlignment="Center">
            <Image Source="Assets/afede_logo.png" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="KidaGo Sync" FontFamily="{StaticResource BrandFont}" FontSize="36"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Window>
